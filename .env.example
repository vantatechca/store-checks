# --- Database (SQLite file; on Railway/Render mount a volume at /data) ---
DATABASE_URL="file:./dev.db"
# Production example: DATABASE_URL="file:/data/store-checks.db"

# --- Discord (channel settings -> Integrations -> Webhooks -> New Webhook) ---
DISCORD_WEBHOOK_URL=""

# --- Cloudinary (dashboard -> API keys) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- AI screenshot analysis (only ambiguous pages are sent to AI) ---
# Primary provider: "gemini" or "openai". If the primary fails and the other
# key is set, it is used as fallback automatically.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
# Optional model overrides:
# GEMINI_MODEL="gemini-2.0-flash"
# OPENAI_MODEL="gpt-4o-mini"

# --- Schedule (default: 8 AM and 8 PM Toronto time) ---
TZ="America/Toronto"
CHECK_CRON="0 8,20 * * *"

# --- Tuning ---
CHECK_CONCURRENCY="6"     # how many stores are checked in parallel
NAV_TIMEOUT_MS="30000"    # per-site page load timeout
